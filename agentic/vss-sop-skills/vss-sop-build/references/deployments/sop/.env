# =============================================================================
# SOP BLUEPRINT ENVIRONMENT CONFIGURATION
# =============================================================================
# This file contains environment variables for the SOP blueprint.
# Services: Foundational, VST, SOP apps
#
# Profile variants:
#   bp_sop_2d         - SOP
# =============================================================================

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# These variables control which services are deployed
# User should modify these based on deployment requirements

# Deployment mode: 2d (SOP only supports 2D)
MODE=2d

# Blueprint profile: bp_sop_2d
BP_PROFILE=bp_sop

# Hardware profile for DS/NIM configuration optimization
# Valid values must match the existing hw-*.env files under deployments/nim.
# Common values: H100, L40S, RTX6000PROBW, DGX-THOR, DGX-SPARK
# DO NOT use higher profile value on lower profile hardware (e.g., H100 on L4)
HARDWARE_PROFILE='H100'

# Computed compose profiles (DO NOT MODIFY)
COMPOSE_PROFILES=${BP_PROFILE}_${MODE}

OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=otlp

# =============================================================================
# CORE INFRASTRUCTURE PATHS
# =============================================================================
# Used by: Foundational services, VST, SOP apps
# User MUST modify these paths

# Path to deployments directory
MDX_SAMPLE_APPS_DIR="."

# Path to data directory (for models, videos, data logs)
MDX_DATA_DIR="sop-data"

# Host IP address for networking
HOST_IP='<HOST_IP>'
EXTERNAL_IP="${EXTERNAL_IP}"
EXTERNALLY_ACCESSIBLE_IP="${EXTERNAL_IP}"

# =============================================================================
# API KEYS & CREDENTIALS
# =============================================================================

# NGC CLI API Key (REQUIRED for local NIM deployment)
# Used by: nemotron-nim, cosmos-nim
# Obtain from: https://ngc.nvidia.com/
NGC_CLI_API_KEY='<ngc_api_key>'

# NVIDIA API Key (REQUIRED for build.nvidia.com remote LLM / VLM endpoints)
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=''

# OPENAI API Key (REQUIRED for openai remote LLM / VLM endpoints)
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY='dummy'

# =============================================================================
# MESSAGE BROKER CONFIGURATION
# =============================================================================
# Used by: Foundational services, VST, SOP apps

# Message broker type: kafka or redis
STREAM_TYPE=kafka

# =============================================================================
# HARDWARE & PERCEPTION CONFIGURATION
# =============================================================================
# Used by: SOP perception and analytics services

# Number of sensors/streams to process
NUM_SENSORS=1

# Computed endpoints (DO NOT MODIFY)
MEDIA_SERVICE_ENDPOINT="${HOST_IP}"
REACT_APP_API_ENDPOINT_BASE_URL="${HOST_IP}:8081"

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================

# Project name for volume naming (DO NOT MODIFY)
COMPOSE_PROJECT_NAME=mdx

# Video Analytics API Port
MDX_PORT=8081

# NAT_LOG_LEVEL=DEBUG

# =============================================================================
# VST (VIDEO STORAGE TOOL) CONFIGURATION
# =============================================================================
# Used by: vss-agent, vss-ui

# VST Base Configuration
VST_PORT=30888
VST_EXTERNAL_URL=http://${EXTERNAL_IP}:${VST_PORT}
# INTERNAL: vss-agent → VST on the same host (compose uses network_mode: host)
VST_INTERNAL_URL=http://localhost:${VST_PORT}

# VST MCP Configuration
VST_MCP_PORT=8001
# INTERNAL: vss-agent / vss-va-mcp → VST MCP on the same host
VST_MCP_URL=http://localhost:${VST_MCP_PORT}

# VST Adaptor type
# Valid values: vst_rtsp, milestone_onvif
VST_ADAPTOR=vst_rtsp

# VST Image tags for x86 and DGX-THOR
VST_MCP_IMAGE_TAG="3.1.0"
VST_SENSOR_IMAGE_TAG="3.1.0"
VST_RTSPSERVER_IMAGE_TAG="3.1.0"
VST_RECORDER_IMAGE_TAG="3.1.0"
VST_STORAGE_IMAGE_TAG="3.1.0"
VST_REPLAYSTREAM_IMAGE_TAG="3.1.0"
VST_LIVESTREAM_IMAGE_TAG="3.1.0"
NVSTREAMER_IMAGE_TAG="3.1.0"


# =============================================================================
# BLUEPRINT CONFIGURATOR CONFIGURATION
# =============================================================================
# Used by: bp-configurator-2d service

# Profile configuration file for the configurator
CONFIGURATOR_CONFIG_FILE=blueprint_config_sop.yml

# Number of streams to process (matches NUM_SENSORS for SOP)
NUM_STREAMS=${NUM_SENSORS}

# Sample video dataset (if using video files)
SAMPLE_VIDEO_DATASET=sop-app

# AI Bridge endpoint for NIM integration (leave empty if not using NIM)
AI_BRIDGE_ENDPOINT=

# VST Adaptor configuration for Milestone ONVIF integration
# Set these values when VST_ADAPTOR=milestone_onvif
ADAPTOR_IP=
ADAPTOR_USER=
ADAPTOR_PASSWORD=

# Sensor info source: nvstreamer or file
SENSOR_INFO_SOURCE=nvstreamer

# Note that BP_NAME cannot contain underscores due to a minio limitation.
# ---- begin ----
BP_NAME=sopmon-0
NGINX_INGRESS_PORT=8080
MINIO_CONSOLE_PORT=9001
# ---- end ----

# NGINX INGRESS setting
NGINX_INGRESS_NAME=${BP_NAME}-nginx-ingress
# Max body size, affecting how large a file can be uuploaded.
NGINX_INGRESS_CLIENT_MAX_BODY_SIZE=8G


#
# API server setting
API_SERVER_NAME=localhost
API_SERVER_PORT=8300
# How many processes should be fork for API server
API_SERVER_WORKERS=8
API_SERVER_LOG_LEVEL=DEBUG

CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=0

# Use remote LLM endpoint and the DS-SOP container's local VLM endpoint.
# VSS agent appends /v1 to VLM_BASE_URL.
LLM_MODE=remote
VLM_MODE=local
LLM_BASE_URL='https://integrate.api.nvidia.com'
VLM_BASE_URL='http://localhost:8300'
LLM_MODEL_TYPE=nim
VLM_MODEL_TYPE=openai
LLM_ENV_FILE=''
VLM_ENV_FILE=''
#
# Set LLM_NAME based on the provided remote LLM endpoint to any of
# - LLM_NAME=nvidia/nvidia-nemotron-nano-9b-v2
# - LLM_NAME=nvidia/llama-3.3-nemotron-super-49b-v1.5
# - LLM_NAME=openai/gpt-oss-20b
# NOTE: nvidia/nemotron-3-super-120b-a12b is currently listed twice in the
#       build.nvidia.com /v1/models catalog, which trips a duplicate-model
#       assertion in langchain-nvidia-ai-endpoints (>=0.3). Do not use until
#       the catalog is deduped upstream.
LLM_NAME=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_NAME_SLUG=llama-3.3-nemotron-super-49b-v1.5
#
# Set VLM_NAME based on the provided remote VLM endpoint to any of
# - VLM_NAME=nvidia/cosmos-reason2-8b            (build.nvidia.com)
# - VLM_NAME=nvidia/cosmos-reason1-7b            (build.nvidia.com)
# - VLM_NAME=Qwen/Qwen3-VL-8B-Instruct           (internal NIM only)
VLM_NAME=ds_sop_model
VLM_NAME_SLUG=ds_sop_model

# Local NIM ports used when LLM_MODE / VLM_MODE are local or local_shared.
LLM_PORT=30081
VLM_PORT=30082
VLM_NIM_KVCACHE_PERCENT="0.7"

# =============================================================================
# VSS AGENT CONFIGURATION
# =============================================================================
# Used by: vss-agent, vss-va-mcp, vss-ui services

# VSS Agent Core
VSS_AGENT_VERSION=3.1.0
VSS_AGENT_CONFIG_FILE=./deployments/sop/vss-agent/configs/config.yml
VSS_AGENT_HOST=0.0.0.0
VSS_AGENT_PORT=8000
STREAM_MODE=other

# VSS Video Analysis MCP Server
VSS_VA_MCP_CONFIG_FILE=./deployments/sop/vss-agent/configs/va_mcp_server_config.yml
VSS_VA_MCP_PORT=9901

# VSS Agent Templates
VSS_AGENT_TEMPLATE_PATH=./deployments/sop/vss-agent/templates
VSS_AGENT_TEMPLATE_NAME=sop_compliance_report_template.md

# =============================================================================
# AGENT STORAGE & REPORT CONFIGURATION
# =============================================================================
# Used by: vss-agent

VSS_ES_PORT=9200

# Object store type: local_object_store (in-memory, not persisted) or s3
VSS_AGENT_OBJECT_STORE_TYPE=local_object_store

# Base URL for report access
VSS_AGENT_REPORTS_BASE_URL=http://${EXTERNAL_IP}:${VSS_AGENT_PORT}/static/
VSS_AGENT_EXTERNAL_URL=http://${EXTERNAL_IP}:${VSS_AGENT_PORT}

# =============================================================================
# PHOENIX TELEMETRY CONFIGURATION
# =============================================================================
# Used by: vss-agent

# INTERNAL: vss-agent → Phoenix telemetry on the same host
PHOENIX_ENDPOINT=http://localhost:6006

# =============================================================================
# AGENT UI CONFIGURATION
# =============================================================================
# Used by: vss-ui

NEXT_PUBLIC_APP_TITLE="VSS BLUEPRINT"
NEXT_PUBLIC_APP_SUBTITLE="SOP"
NEXT_PUBLIC_WORKFLOW="SOP Agent"
NEXT_PUBLIC_ENABLE_CHAT_TAB=true
NEXT_PUBLIC_ENABLE_ALERTS_TAB=false
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=true
NEXT_PUBLIC_ENABLE_MAP_TAB=false
NEXT_PUBLIC_ENABLE_VIDEO_MANAGEMENT_TAB=false
NEXT_PUBLIC_VIDEO_MANAGEMENT_TAB_ADD_RTSP_ENABLE=false
NEXT_PUBLIC_ENABLE_SEARCH_TAB=false
NEXT_PUBLIC_CHAT_API_CUSTOM_AGENT_PARAMS_JSON={"params":[{"name":"llm_reasoning","label":"LLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""},{"name":"vlm_reasoning","label":"VLM Reasoning","type":"boolean","default-value":false,"changeable":true,"tooltip-info":""}]}

# ElasticSearch Configuration
ELASTIC_SEARCH_PORT=9200
# INTERNAL: vss-agent → ElasticSearch on the same host
ELASTIC_SEARCH_ENDPOINT=http://localhost:${ELASTIC_SEARCH_PORT}

# =============================================================================
# VIDEO ANALYSIS MCP CONFIGURATION
# =============================================================================
# Used by: vss-agent video_analytics_mcp

# INTERNAL: vss-agent → video_analytics MCP on the same host
VIDEO_ANALYSIS_MCP_URL=http://localhost:${VSS_VA_MCP_PORT}

# =============================================================================
# EVAL LLM JUDGE CONFIGURATION
# =============================================================================
EVAL_LLM_JUDGE_NAME=nvidia/llama-3.3-nemotron-super-49b-v1.5
EVAL_LLM_JUDGE_BASE_URL=https://integrate.api.nvidia.com
