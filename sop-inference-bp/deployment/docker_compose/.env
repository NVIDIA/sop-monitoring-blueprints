# Values within begin/end should be unique among instances of sop-inference-bp.
# Note that BP_NAME cannot contain underscores due to a minio limitation.
# ---- begin ----
BP_NAME=sopmon-0
NGINX_INGRESS_PORT=8080
MINIO_CONSOLE_PORT=9001
# ---- end ----

# NGINX INGRESS setting
NGINX_INGRESS_NAME=${BP_NAME}-nginx-ingress
# Max body size, affecting how large a file can be uuploaded.
NGINX_INGRESS_CLIENT_MAX_BODY_SIZE=8G

#
# Redis message broker setting
REDIS_MSG_BROKER_NAME=${BP_NAME}-redis-msg-broker
REDIS_MSG_BROKER_PORT=6379

#
# MinIO database setting
# NOTE: MINIO_NAME cannot contain underscore.
# See https://github.com/minio/minio/issues/13025#issuecomment-903069437
MINIO_NAME=${BP_NAME}-minio
MINIO_IMG_NAME=minio/minio:RELEASE.2025-06-13T11-33-47Z-cpuv1
MINIO_API_PORT=9000
# The below env are defined and used by MinIO.
MINIO_ROOT_USER=sopmon_minioadmin
MINIO_ROOT_PASSWORD=sopmon_minioadmin
MINIO_LOGGER_HTTP_ENABLED=true
MINIO_LOGGER_CONSOLE_ENABLED=true
MINIO_DEBUG=true

#
# API server setting
API_SERVER_NAME=${BP_NAME}-api-server
API_SERVER_IMG_NAME=sop_inference_bp:api_server_1.0.0
API_SERVER_PORT=8000
# How many processes should be fork for API server
API_SERVER_WORKERS=8
API_SERVER_LOG_LEVEL=DEBUG

#
## VLM inference service
VLM_INFERENCE_NAME=${BP_NAME}-vlm-inference
VLM_INFERENCE_IMG_NAME=sop_inference_bp:vlm_inference_service_1.0.0
# path to your finetuned nvila
VLM_INFERENCE_MODEL_PATH_ON_HOST=/tmp/path/to/cosmos-reason1-7b
VLM_INFERENCE_MODEL_PATH_IN_CONTAINER=/workspace/vlm_model
VLM_INFERENCE_LOG_LEVEL=DEBUG
VLM_INFERENCE_SHM_SIZE=8gb
VLM_INFERENCE_TIME_OUT_SECONDS=900

ACTION_SEGMENT_NAME=${BP_NAME}-action-segment
ACTION_SEGMENT_IMG_NAME=sop_inference_bp:action_segment_1.0.0
ACTION_SEGMENT_SHM_SIZE=8gb
ACTION_SEGMENT_SERVICE_LOG_LEVEL=DEBUG
#
# Set environment variables for uboco paths
#
ACTION_SEGMENT_UBOCO_SLOWFAST_PATH_ON_HOST=/tmp/path/to/uboco/checkpoints/SLOWFAST_8x8_R50.pkl
ACTION_SEGMENT_UBOCO_SLOWFAST_PATH_IN_CONTAINER=/workspace/checkpoints/SLOWFAST_8x8_R50.pkl
ACTION_SEGMENT_UBOCO_BPE_PATH_ON_HOST=/tmp/path/to/uboco/checkpoints/bpe_simple_vocab_16e6.txt.gz
# Please do not modify ACTION_SEGMENT_UBOCO_BPE_PATH_IN_CONTAINER.
ACTION_SEGMENT_UBOCO_BPE_PATH_IN_CONTAINER=/workspace/checkpoints/bpe_simple_vocab_16e6.txt.gz
ACTION_SEGMENT_UBOCO_VICLIP_PATH_ON_HOST=/tmp/path/to/uboco/checkpoints/ViClip-InternVid-10M-FLT.pth
ACTION_SEGMENT_UBOCO_VICLIP_PATH_IN_CONTAINER=/workspace/checkpoints/ViClip-InternVid-10M-FLT.pth
#
# for ddm-net
#
ACTION_SEGMENT_DDM_NET_CHECKPOINT_PATH_ON_HOST=/tmp/path/to/ddm/checkpoint.pth.tar
ACTION_SEGMENT_DDM_NET_CHECKPOINT_PATH_IN_CONTAINER=/workspace/ddm/checkpoint.pth.tar
ACTION_SEGMENT_DDM_NET_TIMEOUT_SEC=900
# This variable tells DDM to handle how many frames in a GPU request.
# Smaller means more requests to GPU are generated, more overhead in computation
# but the peak GPU memory usage can also be smaller.
ACTION_SEGMENT_DDM_NET_FRAMES_PER_SEGMENT_HINT=256

#
# This is another action segmentation image for cosmos
#
# FIXME: uncomment if you want CR 1.1 as action segmentation.
#ACTION_SEGMENT_CR_NAME=${BP_NAME}-actioon-segment-cr
#ACTION_SEGMENT_CR_IMG_NAME=sop_inference_bp:action_segment_cr_1.0.0
#ACTION_SEGMENT_CR_CHECKPOINT_PATH_ON_HOST=/tmp/path/to/cosmos_models/cosmos-reason1-7b
#ACTION_SEGMENT_CR_CHECKPOINT_PATH_IN_CONTAINER=/workspace/cosmos_models/cosmos-reason1-7b
#ACTION_SEGMENT_CR_TIMEOUT_SEC=900

#
## SOP Checker service
CHECKER_SERVICE_NAME=${BP_NAME}-checker
CHECKER_SERVICE_SHM_SIZE=256mb
CHECKER_SERVICE_IMG_NAME=sop_inference_bp:checker_service_1.0.0
CHECKER_SERVICE_LOG_LEVEL=DEBUG

#
## Mongo database
MONGO_NAME=${BP_NAME}-mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=sopmon_mongoadmin
MONGO_INITDB_ROOT_PASSWORD=sopmon_mongoadmin
MONGO_LOG_LEVEL=WARNING
MONGO_DB_PATH_IN_CONTAINER=/data/db
MONGO_DB_LOG_DIR_IN_CONTAINER=/var/log/mongodb

#
## Demo WEB UI
DEMO_WEB_APP_NAME=${BP_NAME}-demo-web-app
DEMO_WEB_APP_IMG_NAME=sop_inference_bp:demo_web_app_1.0.0
DEMO_WEB_APP_PORT=7860
DEMO_WEB_APP_ROOT_PATH=/sopmon-ui
